*.mp4
*.avi
*.mov
*.mkv
*.webm
*.mpeg
*.mpg

cv/videos/*
videos/*

!cv/videos/.gitkeep
!videos/.gitkeep


# ============================================================
# Generated CV Output
# ============================================================

cv/output/*

!cv/output/.gitkeep
!cv/output/frames/.gitkeep
!cv/output/crops/.gitkeep
!cv/output/clips/.gitkeep


# ============================================================
# Generated CV Event Data
# ============================================================

data/cv_events/*

!data/cv_events/.gitkeep


# ============================================================
# Vector Database / Generated Retrieval Data
# ============================================================

data/chroma/*
!data/chroma/.gitkeep

data/events_store.db


# ============================================================
# Generated Embeddings
# ============================================================

# Future video embedding outputs
data/embeddings/*
!data/embeddings/.gitkeep

# Add other generated embedding/vector directories here
# if your new embedding system creates them.


# ============================================================
# ROI
# ============================================================

# IMPORTANT:
# ROI JSON files are application configuration.
# They should remain tracked.

# Do NOT add:
# cv/roi/


# ============================================================
# Logs
# ============================================================

*.log
logs/
log/
*.out


# ============================================================
# Temporary / Debug
# ============================================================

tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo


# ============================================================
# IDE / Editors
# ============================================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

.ipynb_checkpoints/


# ============================================================
# Node / Frontend
# ============================================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.next/
.nuxt/
.cache/


# ============================================================
# Backend / Frontend Generated Files
# ============================================================

backend/__pycache__/
frontend/.cache/


# ============================================================
# OS Files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db


# ============================================================
# Local Databases
# ============================================================

*.db
*.sqlite
*.sqlite3


# ============================================================
# Generated Reports / Exports
# ============================================================

# Ignore generated exports only in designated folders.
# Do NOT globally ignore CSV/XLSX because they may be useful
# project files later.

data/exports/*
data/reports/*


# ============================================================
# Archives
# ============================================================

# Do not globally ignore ZIP/TAR files.
# Ignore only generated archives in specific locations.

data/archives/*


# ============================================================
# Reference Projects
# ============================================================

# Leave reference/ tracked unless the team decides
# these should remain local-only.

# reference/


# ============================================================
# Project Files That SHOULD REMAIN TRACKED
# ============================================================

# Examples:
#
# cv/*.py
# cv/requirements.txt
# cv/roi/*.json
# retrieval/**/*.py
# backend/**/*.py
# frontend/src/**
# README.md
# .gitignore
# requirements.txt
# .env.example